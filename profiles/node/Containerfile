# Generic Containerfile for the node profile.
# Installs production dependencies only and runs the package's start script.

FROM docker.io/library/node:22-alpine AS deps
WORKDIR /src
COPY package*.json ./
RUN if [ -f package-lock.json ]; then npm ci --omit=dev; else npm install --omit=dev; fi

FROM docker.io/library/node:22-alpine
# Extra runtime packages declared in launch.yml. Alpine, so apk rather than apt.
ARG EXTRA_PACKAGES=""
RUN set -eux; \
    if [ -n "$EXTRA_PACKAGES" ]; then \
        apk add --no-cache $EXTRA_PACKAGES; \
    fi
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=deps /src/node_modules ./node_modules
COPY . .
RUN mkdir -p /config && chown -R app:app /app /config
USER app
ENV NODE_ENV=production
# PORT is injected by the chart from launch.yml.
CMD ["npm", "start"]
